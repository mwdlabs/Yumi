# ─── Identité de l'app (lues au build par app.config.ts) ──────
# Changer ces valeurs suffit à produire une app en marque blanche.
APP_NAME=Yumi
APP_SLUG=yumi
# Scheme des liens profonds : yumi://…
APP_SCHEME=yumi
IOS_BUNDLE_ID=ca.mwdlabs.yumi
ANDROID_PACKAGE=ca.mwdlabs.yumi
# Compte et projet Expo/EAS. Vides = projet Yumi (mwdlabs) ; à changer pour une marque blanche.
EXPO_OWNER=
EAS_PROJECT_ID=

# ─── Exécution (intégrées au bundle JS) ───────────────────────
# URL de l'API, préfixe de version compris. Sur un appareil physique, remplacer
# localhost par l'adresse IP de l'ordinateur sur le réseau local (voir README).
EXPO_PUBLIC_API_URL=http://localhost:3000/v1
