# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Nom affiché dans les courriels et notifications (marque blanche).
APP_NAME=Yumi
LOG_LEVEL=info
# Origines autorisées (CORS), séparées par des virgules. Vide = aucune (l'app mobile n'en a pas besoin).
CORS_ORIGINS=
# Nombre de proxys de confiance devant l'API (0 en local, 1 derrière un load balancer).
TRUST_PROXY=0
# Active les routes /v1/dev/* (déclenchement manuel des rappels…). Jamais en production.
ENABLE_DEV_TOOLS=true

# ─── Services ─────────────────────────────────────────────────
DATABASE_URL=postgresql://yumi:yumi@localhost:5432/yumi
REDIS_URL=redis://localhost:6379

# ─── Sécurité ─────────────────────────────────────────────────
# Secrets de 32 caractères minimum. Générer avec : openssl rand -base64 48
HASH_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_SECRET=change-me-too-change-me-too-change-me-too
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# ─── Codes de connexion (OTP) ─────────────────────────────────
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Nombre maximal de codes par adresse sur une fenêtre de 15 minutes.
OTP_MAX_PER_WINDOW=5

# ─── Courriel (SMTP) ──────────────────────────────────────────
# En local : Mailpit (docker compose), interface sur http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Yumi <no-reply@example.com>"
