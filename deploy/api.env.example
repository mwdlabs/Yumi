# Copier en /opt/yumi/api.env sur le serveur (chmod 600).
# Référence complète : apps/api/.env.example. Les variables NODE_ENV, PORT, DATABASE_URL,
# REDIS_URL et TRUST_PROXY sont fixées dans compose.yml.
APP_NAME=Yumi
LOG_LEVEL=info
ENABLE_DEV_TOOLS=false

# openssl rand -base64 48 (deux valeurs différentes)
HASH_SECRET=
JWT_ACCESS_SECRET=

# Fournisseur d'envoi (ex. Resend : smtp.resend.com, utilisateur « resend »,
# mot de passe = clé API). Le domaine d'envoi doit avoir SPF, DKIM et DMARC.
# DigitalOcean bloque les ports SMTP 25, 465 et 587 : utiliser 2465 (TLS) chez Resend.
SMTP_HOST=smtp.resend.com
SMTP_PORT=2465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
MAIL_FROM="Yumi <no-reply@DOMAINE>"

# Compte de démonstration pour l'examen Apple (code à 6 chiffres).
REVIEW_ACCOUNT_EMAIL=
REVIEW_ACCOUNT_CODE=
